{
  "expo": {
    "name": "GKV App",
    "slug": "gkv-app",
    "scheme": "com.gkv.gkvapp",
    "version": "2.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/265fbf65-f2a5-4f0f-a44b-24a65292631b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.gkv.gkvapp",
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/gkvlogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "265fbf65-f2a5-4f0f-a44b-24a65292631b"
      }
    },
    "owner": "gkv-app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000",
          "enableFullScreenImage_legacy": true
        }
      ]
    ]
  }
}
